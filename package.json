{
  "name": "mini-dokploy",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node --import tsx server.ts",
    "build": "next build",
    "start": "NODE_ENV=production node --import tsx server.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke:auth": "node scripts/smoke-auth.mjs",
    "smoke:deployment": "node scripts/smoke-deployment.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "@trpc/client": "^11.7.0",
    "@trpc/react-query": "^11.7.0",
    "@trpc/server": "^11.7.0",
    "better-auth": "^1.4.0",
    "better-sqlite3": "^12.4.0",
    "drizzle-orm": "^0.45.3",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "superjson": "^2.2.0",
    "tsx": "^4.20.0",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.0",
    "@vitest/coverage-v8": "^3.2.7",
    "drizzle-kit": "^0.31.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
